{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenGlaido",
  "version": "0.1.0",
  "identifier": "com.openglaido.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenGlaido",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0d0d0d",
        "center": true,
        "visible": true
      },
      {
        "label": "hud",
        "title": "OpenGlaido HUD",
        "width": 420,
        "height": 72,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "center": false,
        "visible": false,
        "url": "/#hud"
      },
      {
        "label": "command",
        "title": "OpenGlaido Command",
        "width": 560,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "center": false,
        "visible": false,
        "url": "/#command"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [
        "libs/libllama.0.dylib",
        "libs/libllama-common.0.dylib",
        "libs/libggml.0.dylib",
        "libs/libggml-base.0.dylib",
        "libs/libggml-cpu.0.dylib",
        "libs/libggml-metal.0.dylib"
      ],
      "entitlements": "Entitlements.plist"
    }
  }
}
