# Copy to .release.env.local (gitignored). Signing credentials stay on the build machine.
TAURI_SIGNING_PRIVATE_KEY=/absolute/path/to/openglaido-updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS only: use the Developer ID identity already in your Keychain.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
APPLE_API_KEY=YOUR_KEY_ID
APPLE_API_ISSUER=YOUR_ISSUER_ID
APPLE_API_KEY_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8
